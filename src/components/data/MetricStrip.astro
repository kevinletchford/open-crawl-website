---
/**
 * The four numbers that sum up a crawl, Stripe-dashboard style: label, big
 * value, change since the last crawl, and a sparkline of recent crawls with
 * the previous value as a dotted baseline.
 *
 * Values roll up when scrolled into view. Hovering a sparkline shows that
 * crawl's value in place of the headline until the pointer leaves.
 */
import Figure from './Figure.astro'
import {
  delta,
  formatDelta,
  formatMetric,
  linePath,
  linearScale,
} from '@/lib/chart'
import type { Metric } from '@/data/demo'

interface Props {
  metrics: Metric[]
  caption?: string
  class?: string
}

const { metrics, caption, class: className } = Astro.props

const W = 100
const H = 32

const cells = metrics.map((metric) => {
  const values = [...metric.series, metric.previous]
  const min = Math.min(...values)
  const max = Math.max(...values)
  const pad = (max - min) * 0.12 || 1
  const x = linearScale([0, metric.series.length - 1], [0, W])
  const y = linearScale([min - pad, max + pad], [H, 0])
  const points = metric.series.map((v, i) => [x(i), y(v)] as [number, number])

  // Percentages and scores change in points, not per cent.
  const inPoints = metric.format === 'pct' || metric.format === 'score'
  const change = inPoints
    ? metric.value - metric.previous
    : delta(metric.value, metric.previous)
  const changeText = inPoints
    ? `${change > 0 ? '+' : change < 0 ? '−' : '±'}${Number(Math.abs(change).toFixed(1))} pts`
    : formatDelta(change)
  const improved = change === 0 || change > 0 === metric.higherIsBetter

  return {
    ...metric,
    line: linePath(points),
    baseline: y(metric.previous),
    // Where each point sits, as percentages of the sparkline box.
    dots: points.map(([px, py]) => [(px / W) * 100, (py / H) * 100]),
    changeText,
    improved,
    up: change >= 0,
  }
})
---

<Figure caption={caption} bodyClass="" class={className}>
  <dl class="grid grid-cols-2 gap-px bg-line lg:grid-cols-4">
    {
      cells.map((cell) => (
        <div class="flex flex-col bg-surface p-5 sm:p-6" data-metric>
          <dt class="text-sm text-ink-muted">{cell.label}</dt>
          <dd class="mt-2 text-3xl font-semibold tracking-tight tabular-nums">
            <span
              data-metric-value
              data-count={cell.value}
              data-format={cell.format}
            >
              {formatMetric(cell.value, cell.format)}
            </span>
          </dd>
          <dd
            class:list={[
              'mt-1 flex items-center gap-1 text-xs',
              cell.improved ? 'text-ink' : 'text-ink-muted',
            ]}
          >
            <span aria-hidden="true">{cell.up ? '↑' : '↓'}</span>
            <span>{cell.changeText}</span>
            <span class="text-ink-muted">vs last crawl</span>
          </dd>
          <dd class="relative mt-4 h-8" data-spark>
            <svg
              viewBox={`0 0 ${W} ${H}`}
              preserveAspectRatio="none"
              class="h-full w-full overflow-visible"
              aria-hidden="true"
            >
              <line
                x1="0"
                x2={W}
                y1={cell.baseline}
                y2={cell.baseline}
                class="fade stroke-ink/35"
                stroke-width="1"
                stroke-dasharray="1 3"
                vector-effect="non-scaling-stroke"
              />
              <path
                d={cell.line}
                class="wipe stroke-ink"
                fill="none"
                stroke-width="1.5"
                stroke-linejoin="round"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
            </svg>
            <span
              class="pointer-events-none absolute size-2 -translate-1/2 rounded-full bg-ink ring-2 ring-surface"
              data-spark-dot
              hidden
            />
            <span class="sr-only">
              {formatMetric(cell.series[0], cell.format)} to{' '}
              {formatMetric(cell.value, cell.format)} over the last{' '}
              {cell.series.length} crawls
            </span>
            <script
              is:inline
              type="application/json"
              data-spark-points
              set:html={JSON.stringify({
                dots: cell.dots,
                values: cell.series,
                format: cell.format,
              })}
            />
          </dd>
        </div>
      ))
    }
  </dl>
</Figure>

<script>
  import { fresh } from '@/scripts/data/fresh'
  import { countUp } from '@/scripts/data/count'
  import { formatMetric, type MetricFormat } from '@/lib/chart'

  countUp()

  for (const metric of fresh('[data-metric]')) {
    const spark = metric.querySelector<HTMLElement>('[data-spark]')!
    const dot = metric.querySelector<HTMLElement>('[data-spark-dot]')!
    const value = metric.querySelector<HTMLElement>('[data-metric-value]')!
    const data = JSON.parse(
      metric.querySelector('[data-spark-points]')!.textContent!,
    ) as { dots: [number, number][]; values: number[]; format: MetricFormat }
    const resting = formatMetric(Number(value.dataset.count), data.format)

    spark.addEventListener('pointermove', (event) => {
      const box = spark.getBoundingClientRect()
      const t = (event.clientX - box.left) / box.width
      const i = Math.max(
        0,
        Math.min(
          data.values.length - 1,
          Math.round(t * (data.values.length - 1)),
        ),
      )
      const [left, top] = data.dots[i]
      dot.style.left = `${left}%`
      dot.style.top = `${top}%`
      dot.hidden = false
      value.textContent = formatMetric(data.values[i], data.format)
    })
    spark.addEventListener('pointerleave', () => {
      dot.hidden = true
      value.textContent = resting
    })
  }
</script>
