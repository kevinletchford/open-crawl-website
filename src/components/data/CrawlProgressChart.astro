---
/**
 * Pages discovered and fetched over the course of a crawl, against the
 * previous crawl, in the manner of Stripe's "Gross volume" chart: the number
 * first, the chart as evidence, and a crosshair that reads every series at
 * once. The headline follows the crosshair, then returns to the total.
 *
 * The SVG stretches to the box (`preserveAspectRatio="none"` with
 * non-scaling strokes); dots, labels and the tooltip are HTML on top so
 * they stay round and crisp at any width.
 */
import Figure from './Figure.astro'
import {
  areaPath,
  delta,
  formatDelta,
  formatNumber,
  linePath,
  linearScale,
  niceTicks,
} from '@/lib/chart'
import type { ProgressSample } from '@/data/demo'

interface Props {
  current: ProgressSample[]
  previous: ProgressSample[]
  caption?: string
  class?: string
}

const { current, previous, caption, class: className } = Astro.props

const W = 640
const H = 240
const last = current[current.length - 1]
const prevLast = previous[previous.length - 1]
const duration = last.t
const ticks = niceTicks(Math.max(last.discovered, prevLast.discovered), 3)
const yMax = ticks[ticks.length - 1]
const x = linearScale([0, duration], [0, W])
const y = linearScale([0, yMax], [H, 0])

const line = (samples: ProgressSample[], key: 'discovered' | 'fetched') =>
  samples.map((s) => [x(s.t), y(s[key])] as [number, number])

const discovered = line(current, 'discovered')
const fetched = line(current, 'fetched')
const before = line(previous, 'discovered')
const gradientId = `progress-fill-${Math.random().toString(36).slice(2, 8)}`
const change = formatDelta(delta(last.discovered, prevLast.discovered))

const pct = (value: number, of: number) => (value / of) * 100
const data = current.map((s, i) => ({
  t: s.t,
  x: pct(x(s.t), W),
  discovered: s.discovered,
  fetched: s.fetched,
  previous: previous[i]?.discovered ?? prevLast.discovered,
}))
const xTicks = [0, duration / 2, duration]
---

<Figure
  title="Pages discovered"
  caption={caption}
  class={className}
  bodyClass="p-6 sm:p-8"
>
  <ul
    slot="aside"
    class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-muted"
  >
    <li class="flex items-center gap-2">
      <span class="h-px w-4 bg-ink"></span>Discovered
    </li>
    <li class="flex items-center gap-2">
      <span class="h-px w-4 bg-ink/60"></span>Fetched
    </li>
    <li class="flex items-center gap-2">
      <span class="w-4 border-t border-dotted border-ink/50"></span>Last crawl
    </li>
  </ul>

  <div data-progress>
    <p class="text-4xl font-semibold tracking-tight tabular-nums">
      <span data-progress-value>{formatNumber(last.discovered)}</span>
    </p>
    <p class="mt-1 text-sm text-ink-muted">
      <span data-progress-when>in {duration}s</span>{' '}
      <span aria-hidden="true">·</span>{' '}
      <span class="text-ink" data-progress-delta>{change}</span> vs last crawl
    </p>

    <div class="mt-8 flex gap-3">
      <div
        class="relative h-60 flex-1 cursor-crosshair touch-pan-y outline-none focus-visible:ring-2 focus-visible:ring-ink/40"
        tabindex="0"
        role="slider"
        aria-label={`Pages discovered over ${duration} seconds: ${formatNumber(last.discovered)}, ${change} on the last crawl. Use the arrow keys to read the chart.`}
        aria-valuemin="0"
        aria-valuemax={duration}
        aria-valuenow={duration}
        aria-valuetext={`${formatNumber(last.discovered)} pages discovered in ${duration} seconds`}
        data-progress-plot
      >
        <svg
          viewBox={`0 0 ${W} ${H}`}
          preserveAspectRatio="none"
          class="absolute inset-0 h-full w-full overflow-visible"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id={gradientId} x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="var(--color-ink)" stop-opacity="0.1"
              ></stop>
              <stop offset="1" stop-color="var(--color-ink)" stop-opacity="0"
              ></stop>
            </linearGradient>
          </defs>
          {
            ticks.map((tick) => (
              <line
                x1="0"
                x2={W}
                y1={y(tick)}
                y2={y(tick)}
                class={tick === 0 ? 'stroke-ink/25' : 'stroke-line'}
                vector-effect="non-scaling-stroke"
              />
            ))
          }
          <path
            d={areaPath(discovered, H)}
            fill={`url(#${gradientId})`}
            class="fade"
            style="--delay: 900ms"></path>
          <path
            d={linePath(before)}
            fill="none"
            class="stroke-ink/40"
            stroke-width="1.5"
            stroke-dasharray="1 4"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"></path>
          <path
            d={linePath(fetched)}
            fill="none"
            class="wipe stroke-ink/60"
            stroke-width="1.5"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
            style="--delay: 150ms"></path>
          <path
            d={linePath(discovered)}
            fill="none"
            class="wipe stroke-ink"
            stroke-width="1.5"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"></path>
        </svg>

        <div
          class="pointer-events-none absolute inset-y-0 w-px bg-ink/35"
          data-progress-cross
          hidden
        >
          <span
            class="absolute left-0 size-2 -translate-1/2 rounded-full border border-ink/60 bg-surface"
            data-dot="previous"></span>
          <span
            class="absolute left-0 size-2 -translate-1/2 rounded-full bg-ink/60 ring-2 ring-surface"
            data-dot="fetched"></span>
          <span
            class="absolute left-0 size-2 -translate-1/2 rounded-full bg-ink ring-2 ring-surface"
            data-dot="discovered"></span>
        </div>

        <div
          class="pointer-events-none absolute top-2 z-10 w-44 rounded-lg border border-line bg-surface-alt p-3 text-xs shadow-lg shadow-black/40"
          data-progress-tip
          hidden
        >
          <p class="font-mono text-ink-muted" data-tip="t"></p>
          <dl class="mt-2 space-y-1">
            <div class="flex justify-between gap-3">
              <dt>Discovered</dt>
              <dd class="tabular-nums" data-tip="discovered"></dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-muted">Fetched</dt>
              <dd class="tabular-nums" data-tip="fetched"></dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-muted">Last crawl</dt>
              <dd class="tabular-nums" data-tip="previous"></dd>
            </div>
          </dl>
          <p
            class="mt-2 border-t border-line pt-2 tabular-nums"
            data-tip="delta"
          >
          </p>
        </div>
      </div>

      <div
        class="relative w-10 shrink-0 text-right text-xs text-ink-muted tabular-nums"
        aria-hidden="true"
      >
        {
          ticks.map((tick) => (
            <span
              class="absolute right-0 -translate-y-1/2"
              style={`top: ${pct(y(tick), H)}%`}
            >
              {tick >= 1000 ? `${tick / 1000}k` : tick}
            </span>
          ))
        }
      </div>
    </div>

    <div
      class="mr-13 mt-2 flex justify-between font-mono text-xs text-ink-muted"
      aria-hidden="true"
    >
      {xTicks.map((t) => <span>{t}s</span>)}
    </div>

    <script
      is:inline
      type="application/json"
      data-progress-data
      set:html={JSON.stringify({
        samples: data,
        yMax,
        total: last.discovered,
        duration,
        change,
      })}
    />

    <table class="sr-only">
      <caption>Pages discovered and fetched, by second</caption>
      <thead>
        <tr
          ><th>Second</th><th>Discovered</th><th>Fetched</th><th>Last crawl</th
          ></tr
        >
      </thead>
      <tbody>
        {
          data
            .filter((_, i) => i % 5 === 0 || i === data.length - 1)
            .map((s) => (
              <tr>
                <td>{s.t}</td>
                <td>{s.discovered}</td>
                <td>{s.fetched}</td>
                <td>{s.previous}</td>
              </tr>
            ))
        }
      </tbody>
    </table>
  </div>
</Figure>

<script>
  import { fresh } from '@/scripts/data/fresh'
  import { delta, formatDelta, formatNumber } from '@/lib/chart'

  interface Sample {
    t: number
    x: number
    discovered: number
    fetched: number
    previous: number
  }

  for (const root of fresh('[data-progress]')) {
    const { samples, yMax, total, duration, change } = JSON.parse(
      root.querySelector('[data-progress-data]')!.textContent!,
    ) as {
      samples: Sample[]
      yMax: number
      total: number
      duration: number
      change: string
    }
    const plot = root.querySelector<HTMLElement>('[data-progress-plot]')!
    const cross = root.querySelector<HTMLElement>('[data-progress-cross]')!
    const tip = root.querySelector<HTMLElement>('[data-progress-tip]')!
    const value = root.querySelector<HTMLElement>('[data-progress-value]')!
    const when = root.querySelector<HTMLElement>('[data-progress-when]')!
    const deltaEl = root.querySelector<HTMLElement>('[data-progress-delta]')!
    const dot = (key: string) =>
      cross.querySelector<HTMLElement>(`[data-dot="${key}"]`)!
    const field = (key: string) =>
      tip.querySelector<HTMLElement>(`[data-tip="${key}"]`)!
    const top = (v: number) => `${(1 - v / yMax) * 100}%`
    let index = -1

    const show = (i: number) => {
      index = Math.max(0, Math.min(samples.length - 1, i))
      const s = samples[index]
      const d = formatDelta(delta(s.discovered, s.previous))
      cross.hidden = false
      tip.hidden = false
      cross.style.left = `${s.x}%`
      dot('discovered').style.top = top(s.discovered)
      dot('fetched').style.top = top(s.fetched)
      dot('previous').style.top = top(s.previous)
      // Keep the tooltip inside the plot: right of the line, or left of it
      // past the middle.
      const flip = s.x > 55
      tip.style.left = flip ? '' : `calc(${s.x}% + 12px)`
      tip.style.right = flip ? `calc(${100 - s.x}% + 12px)` : ''
      field('t').textContent = `${s.t}s into the crawl`
      field('discovered').textContent = formatNumber(s.discovered)
      field('fetched').textContent = formatNumber(s.fetched)
      field('previous').textContent = formatNumber(s.previous)
      field('delta').textContent = `${d} vs last crawl`
      value.textContent = formatNumber(s.discovered)
      when.textContent = `at ${s.t}s`
      plot.setAttribute('aria-valuenow', String(s.t))
      plot.setAttribute(
        'aria-valuetext',
        `${s.t} seconds: ${formatNumber(s.discovered)} discovered, ${formatNumber(s.fetched)} fetched, ${d} vs last crawl`,
      )
      deltaEl.textContent = d
    }

    const hide = () => {
      index = -1
      cross.hidden = true
      tip.hidden = true
      value.textContent = formatNumber(total)
      when.textContent = `in ${duration}s`
      deltaEl.textContent = change
    }

    plot.addEventListener('pointermove', (event) => {
      const box = plot.getBoundingClientRect()
      const t = (event.clientX - box.left) / box.width
      show(Math.round(t * (samples.length - 1)))
    })
    plot.addEventListener('pointerleave', hide)
    plot.addEventListener('blur', hide)
    plot.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(index + 1)
      else if (event.key === 'ArrowLeft')
        show(index < 0 ? samples.length - 1 : index - 1)
      else if (event.key === 'Escape') hide()
      else return
      event.preventDefault()
    })
  }
</script>
