---
/**
 * The bespoke glyphs for the "edges left open" features: one small drawing
 * per feature, larger and more literal than the icon set, on a 48×48 grid.
 *
 * Same vocabulary as the icons and the backdrops: rings with gaps from the
 * logo, 45° cuts, and the crawl's fills (solid for readable, hatched for
 * partial, dashed for blocked). Drawn in `currentColor`.
 *
 * - `mcp`: an agent and the crawl, a call going one way and the answer back.
 * - `hooks`: hooks hanging off every stop of the crawl, one holding a page.
 * - `pipe`: pages in, one stream, out to JSON, JSON Lines and SQLite.
 * - `render`: a page cut at 45°, raw markup below and the rendered half
 *   hatched above, with a block a script added.
 * - `polite`: a dial held low, short of the dashed limit: throttled.
 * - `runs`: a stack of saved runs, the latest one's pages on top.
 */
export type GlyphName = 'mcp' | 'hooks' | 'pipe' | 'render' | 'polite' | 'runs'

interface Props {
  name: GlyphName
  size?: number
  class?: string
}

const { name, size = 48, class: className } = Astro.props

// Unique per instance so glyphs on one page don't share a pattern.
const id = `glyph-${name}-${Math.random().toString(36).slice(2, 8)}`
const hatch = `url(#${id}-hatch)`
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden="true"
>
  <defs>
    <pattern
      id={`${id}-hatch`}
      width="4"
      height="4"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line x1="0" y1="0" x2="0" y2="4" stroke-width="1.25"></line>
    </pattern>
    {
      name === 'render' && (
        <clipPath id={`${id}-cut`}>
          <path d="M7 43 41 9V5H7Z" />
        </clipPath>
      )
    }
  </defs>

  {
    name === 'mcp' && (
      <>
        {/* The agent: a ring with a gap where it reaches out. */}
        <path d="M16.59 20.7A8.5 8.5 0 1 1 20.7 16.59" />
        <circle cx="13" cy="13" r="2" fill="currentColor" stroke="none" />
        {/* The call, and the answer coming back. */}
        <path d="M23.04 18.52 29.4 24.88M26.4 24.88h3v-3" />
        <path d="M24.88 29.4 18.52 23.04M21.52 23.04h-3v3" />
        {/* The crawl: the logo's rings. */}
        <circle cx="35" cy="35" r="8.5" />
        <circle cx="35" cy="35" r="3.75" fill="currentColor" />
      </>
    )
  }

  {
    name === 'hooks' && (
      <>
        <path d="M4 8h40" opacity="0.5" />
        {[10, 20, 30, 40].map((x, i) => (
          <>
            <circle cx={x} cy="8" r="2" class="fill-surface" />
            <path
              d={`M${x} 10V${[24, 32, 38, 28][i]}a3 3 0 0 1-6 0v-1.5`}
              opacity={i === 2 ? 1 : 0.6}
            />
          </>
        ))}
        {/* A page caught and carried along. */}
        <rect
          x="25.5"
          y="36.5"
          width="3"
          height="3"
          rx="0.5"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }

  {
    name === 'pipe' && (
      <>
        {/* Pages in: readable, partial, readable. */}
        <rect x="3" y="7.5" width="9" height="5" rx="1" fill="currentColor" />
        <rect x="3" y="21.5" width="9" height="5" rx="1" fill={hatch} />
        <rect x="3" y="35.5" width="9" height="5" rx="1" fill="currentColor" />
        <path
          d="M13.5 10c5 0 5 14 10 14m-10 0h10m-10 14c5 0 5-14 10-14"
          opacity="0.5"
        />
        <circle cx="25" cy="24" r="2.25" fill="currentColor" />
        <path
          d="M27.25 24c4 0 4-14 8-14m-8 14h8m-8 0c4 0 4 14 8 14"
          opacity="0.5"
        />
        {/* JSON. */}
        <path d="M39 6.5c-1.25 0-1.5.75-1.5 1.75v.5c0 .75-.5 1.25-1.25 1.25.75 0 1.25.5 1.25 1.25v.5c0 1 .25 1.75 1.5 1.75m3.5-7c1.25 0 1.5.75 1.5 1.75v.5c0 .75.5 1.25 1.25 1.25-.75 0-1.25.5-1.25 1.25v.5c0 1-.25 1.75-1.5 1.75" />
        {/* JSON Lines. */}
        <path d="M37.5 21.5h7m-7 2.5h7m-7 2.5h7" />
        {/* SQLite. */}
        <ellipse cx="41" cy="35" rx="4" ry="1.75" />
        <path d="M37 35v5.5c0 1 1.8 1.75 4 1.75s4-.75 4-1.75V35" />
      </>
    )
  }

  {
    name === 'render' && (
      <>
        <rect x="7" y="5" width="34" height="38" rx="3" />
        {/* Rendered: what scripts add, above the cut. */}
        <g clip-path={`url(#${id}-cut)`}>
          <rect
            x="7"
            y="5"
            width="34"
            height="38"
            rx="3"
            fill={hatch}
            stroke="none"
          />
        </g>
        <rect
          x="11"
          y="9"
          width="12"
          height="7"
          rx="1"
          fill="currentColor"
          stroke="none"
        />
        <path d="M7.88 42.12 41 9" />
        {/* Raw: the markup, below it. */}
        <path d="m25 31-3 3 3 3m6-6 3 3-3 3m-1.5-6.5-2 7" />
      </>
    )
  }

  {
    name === 'polite' && (
      <>
        {/* A dial held low, well short of the dashed limit. */}
        <path d="M5 31A19 19 0 0 1 37.44 17.56" />
        <path d="M37.44 17.56A19 19 0 0 1 43 31" stroke-dasharray="1.5 3" />
        <path
          d="M11.0 31.0L8.5 31.0M12.74 24.5L10.58 23.25M17.5 19.74L16.25 17.58M24.0 18.0L24.0 15.5M30.5 19.74L31.75 17.58M35.26 24.5L37.42 23.25"
          opacity="0.5"
        />
        <path d="M24 31L15.51 22.51" stroke-width="2" />
        <circle cx="24" cy="31" r="2.5" fill="currentColor" stroke="none" />
        <path d="M10 40h28" opacity="0.35" />
      </>
    )
  }

  {
    name === 'runs' && (
      <>
        {/* Earlier runs, behind. */}
        <path
          d="M14 10V7a3 3 0 0 1 3-3h24a3 3 0 0 1 3 3v24a3 3 0 0 1-3 3h-3"
          opacity="0.35"
        />
        <path
          d="M9 15v-3a3 3 0 0 1 3-3h24a3 3 0 0 1 3 3v24a3 3 0 0 1-3 3h-3"
          opacity="0.6"
        />
        {/* The latest, with its pages. */}
        <rect x="4" y="14" width="30" height="30" rx="3" class="fill-surface" />
        <rect
          x="9"
          y="19"
          width="8.5"
          height="8.5"
          rx="1"
          fill="currentColor"
          stroke="none"
        />
        <rect
          x="20.5"
          y="19"
          width="8.5"
          height="8.5"
          rx="1"
          fill={hatch}
          stroke="none"
        />
        <rect
          x="9"
          y="30.5"
          width="8.5"
          height="8.5"
          rx="1"
          fill={hatch}
          stroke="none"
        />
        <rect
          x="20.5"
          y="30.5"
          width="8.5"
          height="8.5"
          rx="1"
          stroke-dasharray="2 2"
          opacity="0.7"
        />
      </>
    )
  }
</svg>
