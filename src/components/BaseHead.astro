---
import { SITE_DESCRIPTION, SITE_TITLE, SITE_TWITTER } from '@/consts'

interface Props {
  title?: string
  description?: string
  image?: string
  /** Set for article pages so OG reports `article` rather than `website`. */
  type?: 'website' | 'article'
  publishedTime?: Date
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
} = Astro.props

// Astro.site comes from `site:` in astro.config.ts, which reads SITE_URL.
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
{
  publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
