---
/**
 * A benchmark as a race: one maze per runtime (all the same maze), each
 * flooded by a crawl at a speed proportional to that runtime's measured
 * requests per second. Starts when scrolled into view; replayable.
 *
 * Corridors are pre-rendered at build time, tagged with their crawl step;
 * the script only flips opacity as each crawl's step count advances.
 */
import { cellFloorPath, crawl, generateMaze, mazeWallsPath } from '@/lib/maze'
import type { BenchmarkRun } from '@/data/benchmarks'

interface Props {
  run: BenchmarkRun
  /** Seconds the fastest runtime takes to finish. */
  duration?: number
  seed?: number
  rings?: number
  class?: string
}

const {
  run,
  duration = 2.6,
  seed = 7,
  rings = 5,
  class: className,
} = Astro.props

const maze = generateMaze({ seed, rings, cross: false })
const { cellDistance, maxDistance } = crawl(maze)
const walls = mazeWallsPath(maze)
const floors = maze.cells.map((cell) => ({
  d: cellFloorPath(maze, cell),
  step: cellDistance[cell.id],
}))
const r = maze.outerRadius
const viewBox = `${-r} ${-r} ${r * 2} ${r * 2}`
const fastest = Math.max(...run.results.map((result) => result.rps))
const number = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 })
---

<figure
  class:list={['maze-race', className]}
  data-maze-race
  data-max-step={maxDistance}
>
  <div class="grid grid-cols-3 gap-4 sm:gap-8">
    {
      run.results.map((result) => (
        <div
          class="text-center"
          data-racer
          data-duration={(duration * fastest) / result.rps}
        >
          <svg viewBox={viewBox} class="w-full" aria-hidden="true">
            <g class="race-trail">
              {floors.map((floor) => (
                <path d={floor.d} data-step={floor.step} />
              ))}
            </g>
            <path d={walls} fill="currentColor" />
          </svg>
          <p class="mt-3 text-sm font-medium">{result.runtime}</p>
          <p class="font-mono text-xs text-ink-muted">
            <span data-racer-rps data-rps={result.rps}>
              {number.format(result.rps)}
            </span>{' '}
            req/s
          </p>
        </div>
      ))
    }
  </div>
  <noscript>
    <style is:inline>
      .race-trail path {
        opacity: 0.16 !important;
      }
    </style>
  </noscript>
  <figcaption
    class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-ink-muted"
  >
    <span>
      Each maze fills at its runtime’s measured speed ({
        run.title.toLowerCase()
      },
      {run.passes > 1 ? ` ${run.passes}-pass average` : ' single pass'}).
    </span>
    <button
      type="button"
      class="btn btn-ghost px-3 py-1 text-xs"
      data-race-replay
      hidden>Replay</button
    >
  </figcaption>
</figure>

<style>
  .race-trail path {
    fill: var(--color-ink);
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(.band-dark) .race-trail path {
    fill: var(--color-night-ink);
  }
  .race-trail path.is-crawled {
    opacity: 0.16;
  }
</style>

<script>
  const number = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 })
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  for (const race of document.querySelectorAll<HTMLElement>(
    '[data-maze-race]',
  )) {
    const maxStep = Number(race.dataset.maxStep)
    const replay = race.querySelector<HTMLButtonElement>('[data-race-replay]')!
    const racers = [...race.querySelectorAll<HTMLElement>('[data-racer]')].map(
      (el) => {
        // Bucket the corridors by crawl step, so each frame touches only the
        // corridors that were reached since the last one.
        const buckets: Element[][] = Array.from(
          { length: maxStep + 1 },
          () => [],
        )
        for (const path of el.querySelectorAll('[data-step]')) {
          buckets[Number(path.getAttribute('data-step'))]?.push(path)
        }
        const counter = el.querySelector<HTMLElement>('[data-racer-rps]')!
        return {
          duration: Number(el.dataset.duration) * 1000,
          buckets,
          counter,
          rps: Number(counter.dataset.rps),
          shown: -1,
        }
      },
    )

    const show = (racer: (typeof racers)[number], upTo: number) => {
      for (let step = racer.shown + 1; step <= upTo; step++) {
        for (const path of racer.buckets[step]) path.classList.add('is-crawled')
      }
      racer.shown = Math.max(racer.shown, upTo)
    }

    const reset = () => {
      for (const racer of racers) {
        for (const bucket of racer.buckets) {
          for (const path of bucket) path.classList.remove('is-crawled')
        }
        racer.shown = -1
        racer.counter.textContent = '0'
      }
    }

    const run = () => {
      reset()
      replay.hidden = true
      const start = performance.now()
      const tick = (now: number) => {
        let done = true
        for (const racer of racers) {
          const t = Math.min(1, (now - start) / racer.duration)
          show(racer, Math.floor(t * maxStep))
          racer.counter.textContent = number.format(racer.rps * t)
          if (t < 1) done = false
        }
        if (done) replay.hidden = false
        else requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    }

    if (still) {
      for (const racer of racers) show(racer, maxStep)
      continue
    }

    replay.addEventListener('click', run)
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        observer.disconnect()
        run()
      },
      { threshold: 0.5 },
    )
    observer.observe(race)
  }
</script>
