---
/**
 * A benchmark as a race: one maze per runtime, each with a counter that
 * runs up to that runtime's measured requests per second over a time in
 * proportion to its speed. Runs once, when scrolled into view.
 *
 * Every maze is its runtime's initial, carved as a maze from the same seed
 * on an open floor inside the rim: G for Go, T for TypeScript, R for Rust.
 * The rim's doorway leads straight into the letter. Walls only, unfilled:
 * faint at rest, full ink on hover.
 */
import {
  generateMaze,
  glyphRegion,
  mazeWallsPath,
  type Glyph,
} from '@/lib/maze'
import type { BenchmarkResult, BenchmarkRun } from '@/data/benchmarks'

interface Props {
  run: BenchmarkRun
  /** Seconds the fastest runtime takes to finish. */
  duration?: number
  seed?: number
  rings?: number
  class?: string
}

const {
  run,
  duration = 2.6,
  seed = 7,
  rings = 7,
  class: className,
} = Astro.props

const GLYPHS: Record<BenchmarkResult['runtime'], Glyph> = {
  Go: 'G',
  TypeScript: 'T',
  Rust: 'R',
}

// Long cells and thin walls keep the letters open; a small eye leaves them
// room at the centre.
const racers = run.results.map((result) => {
  const maze = generateMaze({
    seed,
    rings,
    eye: 0.6,
    wall: 0.45,
    cellLength: 1.2,
    region: glyphRegion(GLYPHS[result.runtime]),
    regionOnly: true,
  })
  return { result, walls: mazeWallsPath(maze), r: maze.outerRadius }
})
const fastest = Math.max(...run.results.map((result) => result.rps))
const number = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 })
---

<figure class:list={['maze-race', className]} data-maze-race>
  <div class="grid grid-cols-3 gap-4 sm:gap-8">
    {
      racers.map(({ result, walls, r }) => (
        <div
          class="race-racer text-center"
          data-racer
          data-duration={(duration * fastest) / result.rps}
        >
          <svg
            viewBox={`${-r} ${-r} ${r * 2} ${r * 2}`}
            class="w-full"
            aria-hidden="true"
          >
            <path d={walls} fill="currentColor" class="race-walls" />
          </svg>
          <p class="mt-3 text-sm font-medium">{result.runtime}</p>
          <p class="font-mono text-xs text-ink-muted">
            <span data-racer-rps data-rps={result.rps}>
              {number.format(result.rps)}
            </span>{' '}
            req/s
          </p>
        </div>
      ))
    }
  </div>
  <figcaption class="mt-6 text-xs text-ink-muted">
    Each counter runs at its runtime’s measured speed ({
      run.title.toLowerCase()
    },
    {run.passes > 1 ? ` ${run.passes}-pass average` : ' single pass'}).
  </figcaption>
</figure>

<style>
  /* Faint at rest; full ink on hover. */
  .race-walls {
    fill-opacity: 0.2;
    transition: fill-opacity 0.3s;
  }
  .race-racer:hover .race-walls {
    fill-opacity: 1;
  }
</style>

<script>
  const number = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 })
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  for (const race of document.querySelectorAll<HTMLElement>(
    '[data-maze-race]',
  )) {
    const racers = [...race.querySelectorAll<HTMLElement>('[data-racer]')].map(
      (el) => {
        const counter = el.querySelector<HTMLElement>('[data-racer-rps]')!
        return {
          duration: Number(el.dataset.duration) * 1000,
          counter,
          rps: Number(counter.dataset.rps),
        }
      },
    )

    const run = () => {
      for (const racer of racers) racer.counter.textContent = '0'
      const start = performance.now()
      const tick = (now: number) => {
        let done = true
        for (const racer of racers) {
          const t = Math.min(1, (now - start) / racer.duration)
          racer.counter.textContent = number.format(racer.rps * t)
          if (t < 1) done = false
        }
        if (!done) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    }

    if (still) continue

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        observer.disconnect()
        run()
      },
      { threshold: 0.5 },
    )
    observer.observe(race)
  }
</script>
