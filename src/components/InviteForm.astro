---
/**
 * The "Request an invite" form. Without JavaScript it is a plain POST to the
 * Worker (worker/index.ts), which answers with a redirect. With JavaScript it
 * submits in place and swaps itself for a confirmation.
 *
 * Role values must match ROLES in worker/index.ts.
 */
interface Props {
  id?: string
}

const { id = 'invite-form' } = Astro.props

const roles = [
  { value: 'marketing', label: 'Marketing' },
  { value: 'seo', label: 'SEO' },
  { value: 'engineering', label: 'Engineering' },
  { value: 'product', label: 'Product' },
  { value: 'founder', label: 'Founder / leadership' },
  { value: 'agency', label: 'Agency' },
  { value: 'other', label: 'Something else' },
]

const fields = [
  {
    name: 'email',
    label: 'Work email',
    type: 'email',
    required: true,
    wide: true,
    maxlength: 254,
    autocomplete: 'email',
    inputmode: undefined,
  },
  {
    name: 'name',
    label: 'Name',
    type: 'text',
    required: false,
    wide: false,
    maxlength: 120,
    autocomplete: 'name',
    inputmode: undefined,
  },
  {
    name: 'company',
    label: 'Company',
    type: 'text',
    required: false,
    wide: false,
    maxlength: 120,
    autocomplete: 'organization',
    inputmode: undefined,
  },
  {
    name: 'website',
    label: 'Website',
    type: 'text',
    required: false,
    wide: true,
    maxlength: 2048,
    autocomplete: 'url',
    inputmode: 'url',
  },
] as const

// Floating labels: the placeholder is the label's text, hidden, so
// `:placeholder-shown` tells the label whether to sit inside or shrink above.
const input =
  'peer block w-full rounded-xl border border-white/[0.06] bg-white/[0.06] px-5 pt-7 pb-3 text-base text-ink transition-colors placeholder:text-transparent hover:bg-white/[0.09] focus:border-white/40 focus:bg-white/[0.09] focus:outline-none'
const label =
  'pointer-events-none absolute top-[1.15rem] left-5 text-base text-white/55 transition-all peer-focus:top-2.5 peer-focus:text-xs peer-[:not(:placeholder-shown)]:top-2.5 peer-[:not(:placeholder-shown)]:text-xs'
---

<div data-invite class="relative">
  <form
    id={id}
    method="post"
    action="/api/invite"
    class="grid gap-x-4 gap-y-5 sm:grid-cols-2"
    novalidate
  >
    {
      fields.map((f) => (
        <div class:list={['relative', f.wide && 'sm:col-span-2']}>
          <input
            id={`${id}-${f.name}`}
            class={input}
            type={f.type}
            name={f.name}
            required={f.required}
            maxlength={f.maxlength}
            autocomplete={f.autocomplete}
            inputmode={f.inputmode}
            placeholder={f.label}
          />
          <label for={`${id}-${f.name}`} class={label}>
            {f.label}
            {f.required && <span class="text-white/40"> · required</span>}
          </label>
        </div>
      ))
    }
    <fieldset class="mt-4 sm:col-span-2">
      <legend class="mb-4 text-sm text-white/55">Your role</legend>
      <div class="flex flex-wrap gap-2.5">
        {
          roles.map((role) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="role"
                value={role.value}
                class="peer sr-only"
              />
              <span class="block rounded-full border border-white/20 px-4 py-2 text-sm text-white/75 transition-colors peer-checked:border-white peer-checked:bg-white peer-checked:text-black peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white hover:border-white/50">
                {role.label}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- Honeypot: hidden from people; bots that fill it are ignored. -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>
        Company URL
        <input
          type="text"
          name="company_url"
          tabindex="-1"
          autocomplete="off"
        />
      </label>
    </div>

    <div class="mt-6 grid gap-4 sm:col-span-2">
      <button type="submit" class="btn btn-primary w-full py-3.5 text-base">
        Request an invite
      </button>
      <p class="text-center text-xs text-white/50">
        We’ll only use your email to send your invite.
      </p>
    </div>
    <p
      data-invite-error
      role="alert"
      class="hidden text-center text-sm font-medium sm:col-span-2"
    >
    </p>
  </form>

  <div data-invite-done hidden tabindex="-1" class="focus:outline-none">
    <p class="text-2xl font-semibold tracking-tight">You’re on the list.</p>
    <p class="mt-2 text-white/75">
      We’re letting people in a few at a time. Watch your inbox for an invite.
    </p>
  </div>
</div>

<script>
  const MESSAGES: Record<string, string> = {
    invalid_email: 'Please enter a valid email address.',
    invalid_website: 'That website doesn’t look like a valid URL.',
    invalid_role: 'Please choose a role from the list.',
  }
  const FALLBACK = 'Something went wrong. Please try again in a moment.'

  /** Show an error from a no-JS round trip (`/invite?error=…`), if any. */
  const params = new URLSearchParams(location.search)
  const initialError = params.get('error')
  const prefill = params.get('email')

  for (const root of document.querySelectorAll<HTMLElement>('[data-invite]')) {
    const form = root.querySelector('form')!
    const error = root.querySelector<HTMLElement>('[data-invite-error]')!
    const done = root.querySelector<HTMLElement>('[data-invite-done]')!
    const button = form.querySelector('button')!

    const showError = (message: string) => {
      error.textContent = message
      error.classList.remove('hidden')
    }
    if (initialError) showError(MESSAGES[initialError] ?? FALLBACK)

    // Carried over from an email-only CTA (`/invite?email=…`).
    const email = form.elements.namedItem('email') as HTMLInputElement
    if (prefill && !email.value) {
      email.value = prefill
      form.querySelector<HTMLInputElement>('[name=name]')?.focus()
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      error.classList.add('hidden')
      if (!form.reportValidity()) return

      button.disabled = true
      button.textContent = 'Sending…'
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
        const result = (await response.json()) as {
          ok: boolean
          error?: string
        }
        if (!result.ok) throw new Error(result.error)
        form.hidden = true
        done.hidden = false
        done.focus()
      } catch (err) {
        const code = err instanceof Error ? err.message : ''
        showError(MESSAGES[code] ?? FALLBACK)
        button.disabled = false
        button.textContent = 'Request an invite'
      }
    })
  }
</script>
