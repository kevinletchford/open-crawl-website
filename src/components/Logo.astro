---
/**
 * The OpenCrawl logo, traced from `public/Dark.svg` / `public/Light.svg`.
 *
 * The source files paint the gaps in the rings with the background colour.
 * Here those gaps are cut with a mask instead, so the logo is drawn in
 * `currentColor` and works on any band, light or dark.
 */
interface Props {
  variant?: 'full' | 'mark'
  class?: string
  /** Accessible name. Pass an empty string when the logo is decorative. */
  label?: string
}

const { variant = 'full', class: className, label = 'OpenCrawl' } = Astro.props

const viewBox = variant === 'full' ? '191 155 982 205' : '191 155 205 205'
// Unique per instance so several logos on one page don't share a mask.
const maskId = `logo-cut-${Math.random().toString(36).slice(2, 8)}`
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  fill="none"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <mask
    id={maskId}
    maskUnits="userSpaceOnUse"
    x="191"
    y="155"
    width="205"
    height="205"
  >
    <rect x="191" y="155" width="205" height="205" fill="white"></rect>
    <path d="M213.201 335.569L234.789 313.981" stroke="black" stroke-width="16"
    ></path>
    <path d="M348.36 200.41L369.948 178.822" stroke="black" stroke-width="16"
    ></path>
