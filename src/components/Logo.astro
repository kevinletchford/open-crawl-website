    ></path>
    <path d="M234.789 200.41L213.201 178.822" stroke="black" stroke-width="16"
    ></path>
    <path d="M341.355 257.188H371.885" stroke="black" stroke-width="16"></path>
  </mask>
  <g mask={`url(#${maskId})`}>
    <circle
      cx="293.267"
      cy="257.194"
      r="29.7583"
      stroke="currentColor"
      stroke-width="18"></circle>
