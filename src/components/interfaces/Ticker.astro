---
/**
 * Two rails that never stop: what drives the crawl runs in from the left,
 * where results go runs out to the right, each under its half of the line.
 * The rails pause on hover, fade out at the edges, and sit still (wrapped,
 * every item visible) with reduced motion.
 *
 * Each rail repeats its items so one copy always fills the width; the
 * animation slides by exactly one copy, so the loop has no seam.
 */
import Icon from '@/components/Icon.astro'
import { INPUTS, OUTPUTS } from '@/data/interfaces'

interface Props {
  class?: string
}
const { class: className } = Astro.props

const rails = [
  { heading: 'Drive it from anything.', items: INPUTS, reverse: false },
  { heading: 'Send results anywhere.', items: OUTPUTS, reverse: true },
]
// Copies per half of the loop, so a half is wider than any screen.
const copies = 4
---

<div class:list={['space-y-10', className]}>
  {
    rails.map((rail) => (
      <div>
        <p class="text-center text-sm text-ink-muted">{rail.heading}</p>
        <div class="rail mt-4 overflow-hidden">
          <ul
            class:list={['track flex w-max', rail.reverse && 'reverse']}
            aria-label={rail.heading}
          >
            {Array.from({ length: copies * 2 }, (_, copy) =>
              rail.items.map((item) => (
                <li class="pr-3" aria-hidden={copy > 0 ? 'true' : undefined}>
                  <span class="flex items-center gap-3 rounded-full border border-line py-3 pr-6 pl-4 text-lg font-medium whitespace-nowrap transition-colors hover:bg-ink hover:text-surface sm:text-2xl">
                    {item.icon ? (
                      <Icon name={item.icon} size={24} />
                    ) : (
                      <span class="font-mono text-sm text-ink-muted">
                        .{item.name.toLowerCase().replace(/ /g, '')}
                      </span>
                    )}
                    {item.name}
                  </span>
                </li>
              )),
            )}
          </ul>
        </div>
      </div>
    ))
  }
</div>

<style>
  .rail {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: slide 40s linear infinite;
    }
    .track.reverse {
      animation-direction: reverse;
    }
    .rail:hover .track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail {
      mask-image: none;
    }
    .track {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.75rem;
    }
    .track > [aria-hidden] {
      display: none;
    }
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
