---
import Logo from '@/components/Logo.astro'
import { NAV } from '@/consts'

const path = Astro.url.pathname
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href)
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95">
  <div
    class="mx-auto grid h-14 max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-6 px-4 sm:px-6"
  >
    <a href="/" class="shrink-0 justify-self-start" aria-label="OpenCrawl home">
      <Logo class="h-6 w-auto" label="" />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex gap-6 text-sm font-medium tracking-[-0.0125em]">
        {
          NAV.map((item) => (
            <li>
              <a
                class:list={[
                  'transition-colors hover:text-ink',
                  isCurrent(item.href) ? 'text-ink' : 'text-ink-muted',
                ]}
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="col-start-3 flex items-center justify-end gap-3">
      <a
        href="/invite"
        class="btn btn-primary hidden px-4 py-1.5 sm:inline-flex"
      >
        Request an invite
      </a>

      <details class="group relative md:hidden">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-line [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            viewBox="0 0 20 20"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path
              class="group-open:hidden"
              d="M3 6h14M3 10h14M3 14h14"
              stroke-linecap="round"></path>
            <path
              class="hidden group-open:block"
              d="M5 5l10 10M15 5L5 15"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute top-12 right-0 w-56 rounded-card border border-line bg-surface p-2 shadow-lg"
        >
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a
                    class="block rounded-lg px-3 py-2 text-sm hover:bg-surface-alt"
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-line pt-1">
              <a
                class="block rounded-lg px-3 py-2 text-sm font-medium text-ink hover:bg-surface-alt"
                href="/invite"
              >
                Request an invite
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
