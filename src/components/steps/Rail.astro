---
/**
 * The steps as numbered nodes on one rail, each linked to the next:
 * rightwards on wide screens, downwards on narrow ones. A snippet under each
 * shows the step in practice.
 */
import Snippet from './Snippet.astro'
import { STEPS } from '@/data/steps'

interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<ol class:list={['grid gap-10 md:grid-cols-3 md:gap-6', className]}>
  {
    STEPS.map((step, i) => (
      <li class="relative flex flex-col pl-16 md:pl-0">
        {i < STEPS.length - 1 && (
          <span
            class="absolute top-14 -bottom-8 left-5 w-px bg-line md:top-5 md:right-0 md:bottom-auto md:left-16 md:h-px md:w-auto"
            aria-hidden="true"
          >
            <span class="absolute -bottom-px -left-[3.5px] size-2 rotate-45 border-r border-b border-ink-muted md:top-[-3.5px] md:right-px md:bottom-auto md:left-auto md:-rotate-45" />
          </span>
        )}
        <span class="absolute top-0 left-0 grid size-10 place-items-center rounded-full border border-ink bg-surface font-mono text-sm md:static">
          {i + 1}
        </span>
        <h3 class="mt-2 text-xl font-semibold md:mt-6">{step.title}</h3>
        <p class="mt-2 mb-5 text-ink-muted">{step.body}</p>
        <Snippet lines={step.snippet} class="mt-auto" />
      </li>
    ))
  }
</ol>
