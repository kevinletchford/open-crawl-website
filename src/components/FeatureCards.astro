---
/**
 * Three tall product cards, each with a graphic of what it does: a crawl
 * model scoped over a site, a test run over a page, an agent asking for a
 * report. The corner button opens the card's detail over its visual.
 *
 * Content from `src/data/features.ts`; wrap it in a `Section` for the band.
 */
import CrawlMazeSvg from './CrawlMazeSvg.astro'
import MazeSvg from './MazeSvg.astro'
import ModelGraphic from './features/ModelGraphic.astro'
import ReportGraphic from './features/ReportGraphic.astro'
import TestGraphic from './features/TestGraphic.astro'
import {
  FEATURE_CARDS,
  FEATURE_CARDS_HEADING,
  FEATURE_CARDS_INTRO,
} from '@/data/features'

interface Props {
  heading?: string
  intro?: string
  /**
   * What fills each card: a drawn graphic of the product, a product slice
   * over a maze, or the slice alone.
   */
  visual?: 'graphic' | 'maze' | 'none'
  /** Id of a card to render already open. */
  open?: (typeof FEATURE_CARDS)[number]['id']
  class?: string
}

const {
  heading = FEATURE_CARDS_HEADING,
  intro = FEATURE_CARDS_INTRO,
  visual = 'graphic',
  open,
  class: className,
} = Astro.props
const mazes = visual === 'maze'
const GRAPHICS = {
  models: ModelGraphic,
  testing: TestGraphic,
  reporting: ReportGraphic,
}

const MODEL = [
  ['model', 'docs-and-pricing'],
  ['scope', '/docs/**, /pricing/*'],
  ['depth', '6'],
  ['render', 'js when needed'],
  ['pace', '4 req/s, robots.txt'],
]

const TESTS: [boolean, string][] = [
  [true, '412 pages fetched'],
  [true, 'price, currency on every plan'],
  [true, 'nothing crawled out of scope'],
  [false, '3 pages missing plan name'],
]

// Pages pinned on the reporting maze, as fractions of the card's visual.
const PINS = [
  { label: '/pricing', status: '200', x: '10%', y: '10%' },
  { label: '/enterprise', status: 'blocked', x: '38%', y: '30%' },
]
---

<div class={className}>
  {
    heading && (
      <div class="max-w-2xl">
        <h2 class="text-4xl font-semibold tracking-tight text-balance">
          {heading}
        </h2>
        {intro && <p class="mt-4 text-lg text-ink-muted">{intro}</p>}
      </div>
    )
  }
  <div
    class:list={['grid gap-4 lg:grid-cols-3', heading && 'mt-14']}
    data-feature-cards
  >
    {
      FEATURE_CARDS.map((card) => (
        <article
          class="feature-card group relative isolate flex min-h-[34rem] flex-col overflow-hidden rounded-card border border-line bg-surface"
          data-feature-card
          data-open={open === card.id ? '' : undefined}
        >
          <header class="relative z-20 flex items-start justify-between gap-6 p-8">
            <h3 class="max-w-[16ch] text-2xl leading-tight font-medium tracking-tight text-balance sm:text-[1.75rem]">
              {card.title}
            </h3>
            <button
              type="button"
              class="grid size-10 shrink-0 cursor-pointer place-items-center rounded-lg border border-line bg-surface-alt text-ink/80 transition-colors hover:bg-ink hover:text-surface"
              aria-expanded={open === card.id ? 'true' : 'false'}
              aria-controls={`feature-${card.id}`}
              data-feature-toggle
            >
              <span class="sr-only">Details: {card.title}</span>
              <svg
                viewBox="0 0 20 20"
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                {/* A plus, turned into a cross while the card is open */}
                <path class="feature-icon" d="M10 3.5v13M3.5 10h13" />
              </svg>
            </button>
          </header>

          {/* The visual */}
          <div class="feature-visual relative flex-1" aria-hidden="true">
            {visual === 'graphic' &&
              (() => {
                const Graphic = GRAPHICS[card.id]
                return (
                  <>
                    <div class="feature-dots absolute -inset-x-px -top-24 bottom-0" />
                    <Graphic />
                  </>
                )
              })()}
            {visual !== 'graphic' && card.id === 'models' && (
              <>
                {mazes && (
                  <CrawlMazeSvg
                    seed={23}
                    rings={7}
                    duration={3}
                    class="absolute top-1/2 left-1/2 w-[125%] max-w-none -translate-x-1/2 -translate-y-1/2 text-ink/40"
                  />
                )}
                <div
                  class:list={[
                    'absolute inset-x-8 rounded-lg border border-line bg-surface/90 p-4 font-mono text-xs backdrop-blur',
                    // Without the maze to sit in, line up with the other cards.
                    mazes ? 'bottom-10' : 'top-6',
                  ]}
                >
                  <p class="text-ink-muted">models/docs-and-pricing.yaml</p>
                  <dl class="mt-3 grid grid-cols-[5rem_1fr] gap-y-1.5">
                    {MODEL.map(([key, value]) => (
                      <>
                        <dt class="text-ink-muted">{key}</dt>
                        <dd class="text-ink">{value}</dd>
                      </>
                    ))}
                  </dl>
                </div>
              </>
            )}

            {visual !== 'graphic' && card.id === 'testing' && (
              <>
                {mazes && (
                  <MazeSvg
                    seed={41}
                    rings={8}
                    cross
                    bias={0.7}
                    crawl={0.6}
                    class="absolute -bottom-[38%] left-1/2 w-[150%] max-w-none -translate-x-1/2 text-ink/35"
                  />
                )}
                <div class="absolute inset-x-8 top-6 rounded-lg border border-line bg-surface/90 p-4 font-mono text-xs backdrop-blur">
                  <p class="text-ink-muted">$ opencrawl test pricing</p>
                  <ul class="mt-3 space-y-1.5">
                    {TESTS.map(([pass, text]) => (
                      <li
                        class:list={[
                          'flex gap-2',
                          pass ? 'text-ink' : 'text-ink-muted',
                        ]}
                      >
                        <span class="w-3 shrink-0">{pass ? '✓' : '✕'}</span>
                        {text}
                      </li>
                    ))}
                  </ul>
                  <p class="mt-3 border-t border-line pt-3 text-ink-muted">
                    3 passed, 1 failed
                  </p>
                </div>
              </>
            )}

            {visual !== 'graphic' && card.id === 'reporting' && (
              <>
                {mazes && (
                  <MazeSvg
                    seed={67}
                    rings={10}
                    bias={0.8}
                    class="absolute -right-[45%] -bottom-[30%] w-[140%] max-w-none text-ink/30"
                  />
                )}
                <div
                  class:list={[
                    'absolute inset-x-8 space-y-3 text-sm',
                    mazes ? 'top-2' : 'top-6',
                  ]}
                >
                  <p class="ml-auto w-fit max-w-[85%] rounded-lg border border-line bg-surface-alt px-4 py-3">
                    Which pricing pages can’t GPTBot read?
                  </p>
                  <p class="w-fit max-w-[85%] rounded-lg border border-line bg-surface/90 px-4 py-3 backdrop-blur">
                    3 of 412. All under /enterprise, blocked in robots.txt.
                  </p>
                </div>
                {mazes &&
                  PINS.map((pin) => (
                    <span
                      class="absolute flex items-center gap-2 rounded-md border border-line bg-surface/90 px-2.5 py-1.5 font-mono text-xs backdrop-blur"
                      style={`left: ${pin.x}; bottom: ${pin.y}`}
                    >
                      <span class="size-1.5 rounded-full bg-ink" />
                      {pin.label}
                      <span class="text-ink-muted">{pin.status}</span>
                    </span>
                  ))}
              </>
            )}
          </div>

          {/* The detail, over the visual */}
          <div
            id={`feature-${card.id}`}
            class="feature-detail absolute inset-0 z-10 flex flex-col justify-end bg-surface/95 p-8 backdrop-blur-sm"
          >
            <p class="feature-reveal text-ink-muted">{card.summary}</p>
            <ul class="feature-reveal mt-6 space-y-3 border-t border-line pt-6 text-sm">
              {card.points.map((point) => (
                <li class="flex gap-3">
                  <span
                    class="mt-2 size-1 shrink-0 rounded-full bg-ink"
                    aria-hidden="true"
                  />
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  /* The detail slides up over the visual, which eases back under it */
  .feature-detail {
    visibility: hidden;
    transform: translateY(100%);
    transition:
      transform 0.6s var(--ease-66),
      visibility 0.6s;
  }
  [data-open] .feature-detail {
    visibility: visible;
    transform: none;
  }
  /* Its text follows a beat behind on the way in, and leaves with it */
  .feature-reveal {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.35s var(--ease-66),
      transform 0.35s var(--ease-66);
  }
  [data-open] .feature-reveal {
    opacity: 1;
    transform: none;
    transition-duration: 0.6s;
    transition-delay: 0.15s;
  }
  [data-open] .feature-reveal + .feature-reveal {
    transition-delay: 0.25s;
  }
  .feature-visual {
    transition:
      transform 0.6s var(--ease-66),
      opacity 0.6s var(--ease-66);
  }
  [data-open] .feature-visual {
    opacity: 0.4;
    transform: translateY(-2.5rem);
  }
  /* A faint dot grid behind the graphics, fading out from the middle */
  .feature-dots {
    background-image: radial-gradient(
      color-mix(in oklch, var(--color-ink) 14%, transparent) 1px,
      transparent 1px
    );
    background-size: 14px 14px;
    mask-image: radial-gradient(ellipse at 50% 45%, black, transparent 70%);
  }
  .feature-icon {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s var(--ease-66);
  }
  [data-open] .feature-icon {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-detail,
    .feature-reveal,
    .feature-visual,
    .feature-icon {
      transition: none;
    }
  }
</style>

<script>
  import { steps, type Steps } from '@/scripts/feature-steps'

  // Side by side (the lg grid), the graphics play in turn, model to test to
  // report, and the two waiting show their finished picture. Stacked, each
  // plays on its own while it's on screen.
  const SIDE_BY_SIDE = '(min-width: 64rem)'
  // Stacked, how long a card rests on its finished picture between passes.
  const REST = 1500

  for (const group of document.querySelectorAll<HTMLElement>(
    '[data-feature-cards]',
  )) {
    const roots = [
      ...group.querySelectorAll<HTMLElement>(
        '[data-feature-card] [data-steps]',
      ),
    ]
    const players = roots.map(steps)
    if (!players.length || players.some((player) => !player)) continue
    const all = players as Steps[]
    const wide = matchMedia(SIDE_BY_SIDE)
    const shown = new Set<Element>()
    // Bumped to call off a run: the relay's, and each card's on its own.
    let relayId = 0
    const soloIds = all.map(() => 0)

    const relay = async (id: number) => {
      for (let i = 0; ; i = (i + 1) % all.length) {
        if (!(await all[i].play()) || id !== relayId) return
        all[i].stop()
      }
    }
    const solo = async (i: number, id: number) => {
      while ((await all[i].play()) && id === soloIds[i]) {
        all[i].stop()
        await new Promise((done) => setTimeout(done, REST))
        if (id !== soloIds[i] || !shown.has(roots[i])) return
      }
    }
    const startRelay = () => {
      relayId += 1
      for (const player of all) player.stop()
      if (shown.has(group)) relay(relayId)
    }
    const startSolo = (i: number) => {
      soloIds[i] += 1
      all[i].stop()
      if (shown.has(roots[i])) solo(i, soloIds[i])
    }
    const reset = () => {
      relayId += 1
      all.forEach((_, i) => (soloIds[i] += 1))
      for (const player of all) player.stop()
      if (wide.matches) startRelay()
      else all.forEach((_, i) => startSolo(i))
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          if (isIntersecting) shown.add(target)
          else shown.delete(target)
          if (wide.matches && target === group) startRelay()
          if (!wide.matches && target !== group)
            startSolo(roots.indexOf(target as HTMLElement))
        }
      },
      { threshold: 0.3 },
    )
    observer.observe(group)
    for (const root of roots) observer.observe(root)
    wide.addEventListener('change', reset)
  }

  for (const card of document.querySelectorAll<HTMLElement>(
    '[data-feature-card]',
  )) {
    const toggle = card.querySelector<HTMLButtonElement>(
      '[data-feature-toggle]',
    )
    toggle?.addEventListener('click', () => {
      const open = card.toggleAttribute('data-open')
      toggle.setAttribute('aria-expanded', String(open))
    })
    card.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !card.hasAttribute('data-open')) return
      card.removeAttribute('data-open')
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.focus()
    })
  }
</script>
