---
/**
 * The plugins section: a heading, an intro and the four lifecycle hooks
 * from `src/data/hooks.ts`, in one of six treatments:
 *
 * - `list`: the hooks as numbered rows (the product page's original).
 * - `rail`: `preAudit` once, then the per-page steps in a bracket, with the
 *   crawler's own steps (fetch, store) between the hooks.
 * - `loop`: the per-page steps as a ring, the logo's shape, with `preAudit`
 *   joining it from outside.
 * - `code`: a plugin's skeleton, each hook's line annotated beside it.
 * - `trace`: one crawl's log, a line per hook saying what it did.
 * - `states`: what each hook does to a page, drawn in the crawl's fills:
 *   scoped, skipped, rendered, enriched.
 *
 * Content only; wrap it in a `Section` for the band.
 */
import Figure from './data/Figure.astro'
import { HOOKS, HOOKS_HEADING, HOOKS_INTRO } from '@/data/hooks'

interface Props {
  variant?: 'list' | 'rail' | 'loop' | 'code' | 'trace' | 'states'
  heading?: string
  intro?: string
  class?: string
}

const {
  variant = 'list',
  heading = HOOKS_HEADING,
  intro = HOOKS_INTRO,
  class: className,
} = Astro.props

const byName = Object.fromEntries(HOOKS.map((hook) => [hook.hook, hook]))

// The rail: every step of a page, the crawler's own ones muted.
const PAGE_STEPS = ['preCapture', 'fetch', 'render', 'postCapture', 'store']

// The loop: the same steps around a ring, clockwise from the top.
const R = 90
const CX = 220
const CY = 140
const at = (deg: number, r = R) => [
  CX + r * Math.cos((deg * Math.PI) / 180),
  CY + r * Math.sin((deg * Math.PI) / 180),
]
const loop = PAGE_STEPS.map((name, i) => {
  const deg = -90 + i * 72
  const [x, y] = at(deg)
  const [lx, ly] = at(deg, R + 26)
  return {
    name,
    hook: name in byName,
    x,
    y,
    lx,
    ly: ly + 4,
    anchor: Math.abs(lx - CX) < 30 ? 'middle' : lx > CX ? 'start' : 'end',
  }
})
// A chevron halfway between each step, pointing clockwise.
const chevrons = PAGE_STEPS.map((_, i) => {
  const deg = -90 + i * 72 + 36
  const [x, y] = at(deg)
  return {
    d: `M${x - 3.5} ${y - 3.5}l3.5 3.5-3.5 3.5`,
    transform: `rotate(${deg + 90} ${x} ${y})`,
  }
})

// The code: a plugin's skeleton, a line per hook.
const SIGNATURES: Record<string, string> = {
  preAudit: 'preAudit(config)',
  preCapture: 'preCapture(node)',
  render: 'render(node)',
  postCapture: 'postCapture(page)',
}

const TIMES = ['14:32:01.002', '14:32:02.418', '14:32:02.861', '14:32:04.137']
---

<div class={className}>
  <div class="max-w-2xl">
    <h2 class="text-3xl font-semibold tracking-tight text-balance">
      {heading}
    </h2>
    {intro && <p class="mt-4 text-ink-muted">{intro}</p>}
  </div>

  {
    variant === 'list' && (
      <ol class="mt-8 space-y-px overflow-hidden rounded-card border border-line">
        {HOOKS.map((step, i) => (
          <li class="flex gap-4 bg-surface-alt px-5 py-4">
            <span class="font-mono text-sm text-ink-muted">{i + 1}</span>
            <div>
              <p class="font-mono text-sm font-medium">{step.hook}</p>
              <p class="mt-0.5 text-sm text-ink-muted">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    )
  }

  {
    variant === 'rail' && (
      <div class="mt-12 flex flex-col gap-4 lg:flex-row lg:items-stretch">
        <div class="flex flex-col rounded-card border border-line bg-surface p-5 lg:w-56">
          <p class="text-xs text-ink-muted">Once per crawl</p>
          <p class="mt-4 font-mono text-sm font-medium">preAudit</p>
          <p class="mt-1 text-sm text-ink-muted">{byName.preAudit.body}</p>
        </div>
        <div class="flex-1 rounded-card border border-dashed border-line p-3">
          <p class="px-2 pt-1 pb-3 text-xs text-ink-muted">
            For every page, in order
          </p>
          <ol class="grid gap-2 sm:grid-cols-[1fr_auto_1fr_1fr_auto]">
            {PAGE_STEPS.map((name) =>
              byName[name] ? (
                <li class="rounded-xl border border-line bg-surface p-4">
                  <p class="font-mono text-sm font-medium">{name}</p>
                  <p class="mt-1 text-sm text-ink-muted">{byName[name].body}</p>
                </li>
              ) : (
                <li class="grid place-items-center rounded-xl border border-dashed border-line px-3 py-2 sm:border-0">
                  <p class="font-mono text-xs text-ink-muted">{name}</p>
                </li>
              ),
            )}
          </ol>
        </div>
      </div>
    )
  }

  {
    variant === 'loop' && (
      <div class="mt-12 grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <svg
          viewBox="0 0 390 280"
          class="w-full text-ink"
          role="img"
          aria-label="preAudit runs once, then preCapture, fetch, render, postCapture and store run in a loop for every page"
        >
          <circle
            cx={CX}
            cy={CY}
            r={R}
            fill="none"
            stroke="currentColor"
            stroke-opacity="0.35"
          />
          {chevrons.map((chevron) => (
            <path
              d={chevron.d}
              transform={chevron.transform}
              fill="none"
              stroke="currentColor"
              stroke-opacity="0.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          ))}
          <text
            x={CX}
            y={CY + 4}
            text-anchor="middle"
            class="fill-ink-muted font-mono text-[11px]"
          >
            every page
          </text>
          {/* preAudit joins the loop once, from outside. */}
          <path
            d={`M46 ${CY}H${CX - R}`}
            stroke="currentColor"
            stroke-opacity="0.35"
            stroke-dasharray="3 4"
          />
          <circle cx="40" cy={CY} r="6" fill="currentColor" />
          <text
            x="40"
            y={CY + 26}
            text-anchor="middle"
            class="fill-current font-mono text-[11px]"
          >
            preAudit
          </text>
          <text
            x="88"
            y={CY - 8}
            text-anchor="middle"
            class="fill-ink-muted font-mono text-[10px]"
          >
            once
          </text>
          {loop.map((step) => (
            <g>
              {step.hook ? (
                <>
                  <circle
                    cx={step.x}
                    cy={step.y}
                    r="9"
                    class="fill-surface"
                    stroke="currentColor"
                  />
                  <circle cx={step.x} cy={step.y} r="4.5" fill="currentColor" />
                </>
              ) : (
                <circle
                  cx={step.x}
                  cy={step.y}
                  r="3.5"
                  class="fill-surface"
                  stroke="currentColor"
                  stroke-opacity="0.6"
                />
              )}
              <text
                x={step.lx}
                y={step.ly}
                text-anchor={step.anchor}
                class:list={[
                  'font-mono text-[11px]',
                  step.hook ? 'fill-current' : 'fill-ink-muted',
                ]}
              >
                {step.name}
              </text>
            </g>
          ))}
        </svg>
        <dl class="divide-y divide-line border-y border-line">
          {HOOKS.map((step) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-4">
              <dt class="font-mono text-sm font-medium">{step.hook}</dt>
              <dd class="text-sm text-ink-muted">{step.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  {
    variant === 'code' && (
      <Figure class="mt-12" bodyClass="" caption="Illustrative plugin">
        <div class="font-mono text-sm">
          <p class="px-6 pt-5 text-ink-muted sm:px-8">export default {'{'}</p>
          <ul>
            {HOOKS.map((step) => (
              <li class="grid gap-x-10 gap-y-1 px-6 py-3 sm:px-8 lg:grid-cols-[18rem_1fr]">
                <code class="pl-6">
                  {SIGNATURES[step.hook]}{' '}
                  <span class="text-ink-muted">{'{ … },'}</span>
                </code>
                <p class="font-sans text-sm text-ink-muted max-lg:pl-6">
                  <span class="text-ink/80">
                    {step.runs === 'crawl' ? 'Once per crawl.' : 'Every page.'}
                  </span>{' '}
                  {step.body}
                </p>
              </li>
            ))}
          </ul>
          <p class="px-6 pb-5 text-ink-muted sm:px-8">{'}'}</p>
        </div>
      </Figure>
    )
  }

  {
    variant === 'trace' && (
      <Figure
        class="mt-12"
        title="acme.dev · run r_8f2c"
        bodyClass=""
        caption="Illustrative crawl"
      >
        <ol class="divide-y divide-line font-mono text-xs sm:text-sm">
          {HOOKS.map((step, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 px-6 py-4 sm:px-8 md:grid-cols-[8rem_9rem_9rem_1fr]">
              <span class="text-ink-muted">{TIMES[i]}</span>
              <span class="font-medium">{step.hook}</span>
              <span class="text-ink-muted max-md:col-start-2">
                {step.trace.target}
              </span>
              <span class="text-ink/80 max-md:col-start-2">
                {step.trace.did}
              </span>
            </li>
          ))}
        </ol>
      </Figure>
    )
  }

  {
    variant === 'states' && (
      <div class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {HOOKS.map((step) => (
          <div class="bg-surface p-6">
            <svg
              viewBox="0 0 120 64"
              class="w-full text-ink"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <defs>
                <pattern
                  id={`hooks-hatch-${step.hook}`}
                  width="4"
                  height="4"
                  patternUnits="userSpaceOnUse"
                  patternTransform="rotate(45)"
                >
                  <line x1="0" y1="0" x2="0" y2="4" stroke-width="1.25" />
                </pattern>
              </defs>
              {step.hook === 'preAudit' && (
                <>
                  {/* The site's pages, and the scope drawn round some. */}
                  {Array.from({ length: 12 }, (_, i) => {
                    const x = 10 + (i % 6) * 17
                    const y = 12 + Math.floor(i / 6) * 22
                    const inScope = i % 6 < 3
                    return (
                      <rect
                        x={x}
                        y={y}
                        width="12"
                        height="12"
                        rx="2"
                        fill={inScope ? 'currentColor' : 'none'}
                        stroke={inScope ? 'none' : 'currentColor'}
                        opacity={inScope ? 0.85 : 0.3}
                      />
                    )
                  })}
                  <rect
                    x="4"
                    y="6"
                    width="57"
                    height="52"
                    rx="5"
                    stroke-dasharray="3 3"
                  />
                </>
              )}
              {step.hook === 'preCapture' && (
                <>
                  <rect
                    x="12"
                    y="20"
                    width="24"
                    height="24"
                    rx="3"
                    fill="currentColor"
                    stroke="none"
                    opacity="0.85"
                  />
                  <path d="M46 32h26m-5-5 5 5-5 5" opacity="0.5" />
                  <rect
                    x="84"
                    y="20"
                    width="24"
                    height="24"
                    rx="3"
                    stroke-dasharray="3 3"
                    opacity="0.7"
                  />
                  <path d="m91 27 10 10m0-10-10 10" opacity="0.7" />
                </>
              )}
              {step.hook === 'render' && (
                <>
                  <rect x="12" y="20" width="24" height="24" rx="3" />
                  <path d="m21 28-3 4 3 4m6-8 3 4-3 4" opacity="0.7" />
                  <path d="M46 32h26m-5-5 5 5-5 5" opacity="0.5" />
                  <rect
                    x="84"
                    y="20"
                    width="24"
                    height="24"
                    rx="3"
                    fill={`url(#hooks-hatch-${step.hook})`}
                  />
                  <rect
                    x="88"
                    y="24"
                    width="10"
                    height="6"
                    rx="1"
                    fill="currentColor"
                    stroke="none"
                  />
                </>
              )}
              {step.hook === 'postCapture' && (
                <>
                  <rect
                    x="12"
                    y="20"
                    width="24"
                    height="24"
                    rx="3"
                    fill="currentColor"
                    stroke="none"
                    opacity="0.85"
                  />
                  <path d="M42 32h18m-5-5 5 5-5 5" opacity="0.5" />
                  <rect
                    x="66"
                    y="20"
                    width="24"
                    height="24"
                    rx="3"
                    fill="currentColor"
                    stroke="none"
                    opacity="0.85"
                  />
                  <path d="M71 27h8m-8 5h14m-8 5h8" class="stroke-surface" />
                  {/* Out to a sink. */}
                  <path d="M92 32h6" opacity="0.5" />
                  <ellipse cx="108" cy="25" rx="7" ry="2.75" />
                  <path d="M101 25v14c0 1.5 3.1 2.75 7 2.75s7-1.25 7-2.75V25" />
                </>
              )}
            </svg>
            <p class="mt-6 font-mono text-sm font-medium">{step.hook}</p>
            <p class="mt-1 text-xs text-ink-muted">
              {step.runs === 'crawl' ? 'Once per crawl' : 'Every page'}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              {step.body}
            </p>
          </div>
        ))}
      </div>
    )
  }
</div>
