---
/**
 * One glyph from the OpenCrawl icon set (`src/lib/icons.ts`), drawn in
 * `currentColor` so it takes the text colour of wherever it sits.
 *
 * Decorative by default. Pass `label` when the icon carries meaning on its
 * own (a status with no text beside it, say), as with `Logo.astro`.
 */
import { ICONS, type IconName } from '@/lib/icons'

interface Props {
  name: IconName
  size?: 16 | 20 | 24
  variant?: 'outline' | 'solid'
  label?: string
  class?: string
}

const {
  name,
  size = 20,
  variant = 'outline',
  label,
  class: className,
} = Astro.props

// Unique per instance so solid icons on one page don't share a mask.
const id = `icon-${name}-${Math.random().toString(36).slice(2, 8)}`
const markup = ICONS[name][variant].replaceAll('{id}', id)
// Thin strokes vanish at 16px, so the smallest size draws a touch heavier.
const strokeWidth = size === 16 ? 1.75 : 1.5
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={markup}
/>
