---
import InviteForm from '@/components/InviteForm.astro'
import MazeSvg from '@/components/MazeSvg.astro'
import Section from '@/components/Section.astro'

interface Props {
  heading?: string
}

const { heading = 'OpenCrawl is invite-only, for now.' } = Astro.props
---

<Section tone="dark" id="invite">
  <MazeSvg
    slot="backdrop"
    seed={404}
    rings={9}
    class="pointer-events-none absolute top-1/2 -right-1/3 -z-10 w-[56rem] max-w-none -translate-y-1/2 text-white/[0.06] lg:-right-48"
  />
  <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div>
      <p class="eyebrow">Early access</p>
      <h2
        class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
      >
        {heading}
      </h2>
      <p class="mt-5 max-w-md text-lg text-ink-muted">
        We’re onboarding teams in small batches so every crawl gets our full
        attention. Tell us a little about your site and we’ll be in touch.
      </p>
    </div>
    <div
      class="rounded-card border border-line bg-night-alt/70 p-6 backdrop-blur sm:p-8"
    >
      <InviteForm />
    </div>
  </div>
</Section>
