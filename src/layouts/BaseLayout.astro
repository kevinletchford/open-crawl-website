---
import BaseHead from '@/components/BaseHead.astro'
import { SITE_TITLE } from '@/consts'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  publishedTime?: Date
}

const year = new Date().getFullYear()

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header class="border-b border-black/10">
      <div
        class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
      >
        <a href="/" class="text-lg font-semibold tracking-tight">
          {SITE_TITLE}
        </a>
        <nav aria-label="Main">
          <ul class="flex gap-6 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a class="hover:text-brand-600" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 py-16">
      <slot />
    </main>

    <footer class="border-t border-black/10">
      <div
        class="mx-auto max-w-5xl px-6 py-8 text-sm text-[color:var(--color-ink-muted)]"
      >
        &copy; {year}
        {SITE_TITLE}
      </div>
    </footer>
  </body>
</html>
