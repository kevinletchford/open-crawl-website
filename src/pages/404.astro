---
import Section from '@/components/Section.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist on OpenCrawl."
>
  <Section width="narrow">
    <h1 class="text-5xl font-semibold tracking-tight">Dead end.</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Even crawlers hit walls. The page you were looking for isn't here — it may
      have moved, or the link may be out of date.
    </p>
    <a class="btn btn-primary mt-8" href="/">&larr; Back to the start</a>
  </Section>
</BaseLayout>
