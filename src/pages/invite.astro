---
import InviteForm from '@/components/InviteForm.astro'
import MazeSvg from '@/components/MazeSvg.astro'
import Section from '@/components/Section.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const perks = [
  'The crawl engine, CLI and MCP server',
  'Help wiring it into your agents and pipelines',
  'Direct access to the team building it',
]
---

<BaseLayout
  title="Request an invite"
  description="OpenCrawl is invite-only. Request early access to a fast, open crawler built for agents and pipelines."
>
  <Section innerClass="pt-16 pb-24 sm:pt-24">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <h1
          class="text-5xl font-semibold tracking-tight text-balance sm:text-6xl"
        >
          Request an invite.
        </h1>
        <p class="mt-6 max-w-md text-lg text-ink-muted">
          OpenCrawl is invite-only while we onboard teams in small batches. Tell
          us what you’re crawling and we’ll be in touch.
        </p>
        <ul class="mt-10 space-y-4">
          {
            perks.map((perk, i) => (
              <li class="flex items-center gap-3">
                <MazeSvg
                  seed={300 + i}
                  rings={2}
                  cellLength={2.2}
                  crawl={1}
                  class="size-7 shrink-0 text-ink"
                />
                {perk}
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="rounded-[1.25rem] border border-white/10 bg-night-alt p-7 sm:p-10"
      >
        <InviteForm />
      </div>
    </div>
  </Section>
</BaseLayout>
