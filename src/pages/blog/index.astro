---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<BaseLayout title="Blog" description="Writing from the Open-Crawl team.">
  <h1 class="text-4xl font-bold tracking-tight">Blog</h1>

  <ul class="mt-10 space-y-8">
    {
      posts.map((post) => (
        <li>
          <article>
            <h2 class="text-xl font-semibold">
              <a class="hover:text-brand-600" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>
            <time
              class="mt-1 block text-sm text-[color:var(--color-ink-muted)]"
              datetime={post.data.pubDate.toISOString()}
            >
              {dateFormat.format(post.data.pubDate)}
            </time>
            <p class="mt-2 text-[color:var(--color-ink-muted)]">
              {post.data.description}
            </p>
          </article>
        </li>
      ))
    }
  </ul>
</BaseLayout>
