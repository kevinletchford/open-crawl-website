---
import { getCollection } from 'astro:content'
import Section from '@/components/Section.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<BaseLayout title="Blog" description="Writing from the OpenCrawl team.">
  <Section width="narrow">
    <h1 class="text-5xl font-semibold tracking-tight">Notes from the maze</h1>

    <ul class="mt-10 space-y-8">
      {
        posts.map((post) => (
          <li>
            <article>
              <h2 class="text-xl font-semibold">
                <a class="hover:text-ink-muted" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>
              <time
                class="mt-1 block text-sm text-ink-muted"
                datetime={post.data.pubDate.toISOString()}
              >
                {dateFormat.format(post.data.pubDate)}
              </time>
              <p class="mt-2 text-ink-muted">{post.data.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
