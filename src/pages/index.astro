---
import Logo from '@/components/Logo.astro'
import Section from '@/components/Section.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { GITHUB_URL, SITE_DESCRIPTION } from '@/consts'
---

<BaseLayout description={SITE_DESCRIPTION}>
  <Section tone="dark" innerClass="py-28 sm:py-40">
    <Logo variant="mark" class="size-16" label="" />
    <h1
      class="mt-10 max-w-3xl text-5xl font-semibold tracking-tight text-balance sm:text-7xl"
    >
      See your site the way AI sees it.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
      {SITE_DESCRIPTION}
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/blog" class="btn btn-primary">Read the blog</a>
      <a href={GITHUB_URL} class="btn btn-ghost">View on GitHub</a>
    </div>
  </Section>
</BaseLayout>
