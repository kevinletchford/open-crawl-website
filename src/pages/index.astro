---
import HeroMaze from '@/components/HeroMaze.astro'
import EngineFeatures from '@/components/EngineFeatures.astro'
import CtaCommand from '@/components/cta/CtaCommand.astro'
import FeatureCards from '@/components/FeatureCards.astro'
import HowItWorks from '@/components/HowItWorks.astro'
import RequestTicker from '@/components/RequestTicker.astro'
import Section from '@/components/Section.astro'
import Switchboard from '@/components/interfaces/Switchboard.astro'
import CrawlGridBackdrop from '@/components/backdrops/CrawlGridBackdrop.astro'
import CrawlModeChart from '@/components/data/CrawlModeChart.astro'
import { SITE_DESCRIPTION } from '@/consts'
import { CRAWL_MODES, SYNTHETIC } from '@/data/benchmarks'
import { LOG } from '@/data/demo'
import BaseLayout from '@/layouts/BaseLayout.astro'

const fastest = Math.max(...SYNTHETIC.results.map((r) => r.rps))
const rps = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 })
const measured = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(CRAWL_MODES.date))
---

<BaseLayout description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <Section tone="dark" innerClass="pt-28 pb-16 text-center sm:pt-40 sm:pb-24">
    <div
      slot="backdrop"
      class="pointer-events-none absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,#000_55%,transparent)]"
    >
      <HeroMaze
        class="absolute top-1/2 left-1/2 w-[max(44rem,min(72rem,100vw))] -translate-x-1/2 -translate-y-1/2"
      />
      <!-- Darkens the maze's middle so the copy stays legible over it. -->
      <div
        class="absolute inset-0 bg-[radial-gradient(42%_38%_at_50%_50%,black_30%,transparent)]"
      >
      </div>
    </div>
    <h1
      class="mx-auto max-w-4xl text-4xl leading-10 font-medium tracking-[-0.0225em] text-balance sm:text-5xl sm:leading-[3.5rem]"
    >
      The open crawler built for agents.
    </h1>
    <p
      class="mx-auto mt-4 max-w-[44rem] text-[17px] leading-6 text-pretty text-ink/60 sm:text-lg"
    >
      {SITE_DESCRIPTION}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/invite" class="btn btn-primary">Request an invite</a>
      <a href="#how-it-works" class="btn btn-ghost">How it works</a>
    </div>
  </Section>

  <!-- A crawl running: the hero's product shot -->
  <Section width="default" innerClass="pt-0 pb-20 sm:pt-0 sm:pb-28">
    <RequestTicker entries={LOG} variant="inflight" class="mx-auto max-w-4xl" />
  </Section>

  <!-- What it does, card by card -->
  <Section tone="alt">
    <FeatureCards />
  </Section>

  <!-- Interfaces: the answer to "fitting it in" -->
  <Section width="wide">
    <h2
      class="mx-auto max-w-2xl text-center text-4xl font-semibold tracking-tight text-balance"
    >
      Drive it from anything. Send results anywhere.
    </h2>
    <Switchboard class="mt-12" />
  </Section>

  <!-- Features -->
  <Section tone="dark">
    <CrawlGridBackdrop
      slot="backdrop"
      variant="flood"
      seed={7}
      crawls={5}
      scale={0.6}
      class="inset-0 opacity-50"
    />
    <!-- Darkens the maze behind the heading so it stays readable. -->
    <div
      slot="backdrop"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_40%_30%_at_25%_15%,black_30%,transparent_100%)]"
      aria-hidden="true"
    >
    </div>
    <EngineFeatures />
    <a href="/product" class="btn btn-ghost mt-10">Explore the product →</a>
  </Section>

  <!-- How it works -->
  <Section id="how-it-works">
    <HowItWorks variant="journey" />
  </Section>

  <!-- Speed -->
  <Section tone="alt">
    <div class="max-w-2xl">
      <h2 class="text-4xl font-semibold tracking-tight text-balance">
        {rps.format(fastest)} requests a second, when the network gets out of the
        way.
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        The crawl engine is benchmarked across Go, Rust and TypeScript on every
        change, against a synthetic site and the live web.
      </p>
    </div>
    <CrawlModeChart
      html={CRAWL_MODES.html}
      rendered={CRAWL_MODES.rendered}
      samples={CRAWL_MODES.samples}
      caption={`Measured ${measured} · ${CRAWL_MODES.target} · ${CRAWL_MODES.html.concurrency} requests vs ${CRAWL_MODES.rendered.concurrency} Chrome tabs in flight`}
      class="mt-12"
    />
    <a href="/benchmarks" class="btn btn-ghost mt-10">See the benchmarks →</a>
  </Section>

  <CtaCommand variant="typed" />
</BaseLayout>
