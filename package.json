{
  "name": "open-crawl-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for Open-Crawl",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && pnpm run check:worker",
    "check:worker": "wrangler types worker/worker-configuration.d.ts >/dev/null && tsc -p worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "astro build && wrangler deploy",
    "dev:worker": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply open-crawl-invites --local",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.126.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
