{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-crawl-website",
  "compatibility_date": "2026-08-26",

  // Static-assets-only Worker: no "main", no compatibility_flags, no server
  // entrypoint. Astro builds to ./dist and Cloudflare serves it from the edge.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
